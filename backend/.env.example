# Turso Hosted SQLite Configuration
# When provided, the backend will connect to Turso Cloud instead of the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite override (used only if Turso is not configured)
# DATABASE_PATH=signal_clone.db

# Production CORS (e.g. your Vercel frontend URL, comma separated or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
